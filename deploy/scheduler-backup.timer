[Unit]
Description=Сторож бази планувальника Bravo (копія кожні 30 хв, відновлення при втраті даних)

[Timer]
# Кожні півгодини: о :00 і о :30.
OnCalendar=*:0/30
# Невеликий розкид, щоб знімок не збігався секунда-в-секунду з іншими
# завданнями системи. Тримаємо коротким - інакше "кожні 30 хв" попливе.
RandomizedDelaySec=60
# Якщо сервер був вимкнений у момент запуску - виконати одразу після старту,
# а не чекати наступного слоту. Саме тут це важливо: після перезавантаження
# перевірка стану бази має відбутися негайно.
Persistent=true

[Install]
WantedBy=timers.target
