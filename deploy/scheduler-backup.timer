[Unit]
Description=Щоденна резервна копія бази планувальника Bravo

[Timer]
# Щодня о 03:30. RandomizedDelaySec - щоб дамп не збігався секунда-в-секунду
# з іншими нічними завданнями системи.
OnCalendar=*-*-* 03:30:00
RandomizedDelaySec=15m
# Якщо сервер був вимкнений у момент запуску - зробити копію одразу після
# наступного старту, а не чекати ще добу.
Persistent=true

[Install]
WantedBy=timers.target
