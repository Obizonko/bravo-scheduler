# ==============================
# Server
# ==============================
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ==============================
# Database driver
# Дозволяє в майбутньому перемкнутися з Google Sheets на PostgreSQL/MongoDB
# без зміни бізнес-логіки (service/controller шарів).
# Підтримувані значення: google_sheets | postgres | mongo
# ==============================
DB_DRIVER=google_sheets

# ==============================
# Google Sheets (використовується, якщо DB_DRIVER=google_sheets)
# ==============================
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Приватний ключ сервісного акаунта. Якщо копіюєте з JSON-файлу,
# залиште символи \n як є - вони екрануються автоматично в коді.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Назви аркушів (можна змінити, якщо в таблиці інші назви)
SHEET_USERS=Users
SHEET_SHIFTS=Shifts
SHEET_SCHEDULE=Schedule
SHEET_MASTER_PLAN=Master_plan

# ==============================
# Logging
# ==============================
LOG_LEVEL=info

# ==============================
# CORS
# ==============================
CORS_ORIGIN=*
