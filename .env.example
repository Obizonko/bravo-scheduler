# ==============================
# Server
# ==============================
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ==============================
# Database driver
# Дозволяє перемикати сховище даних без зміни бізнес-логіки
# (service/controller шари від цього не залежать).
# Підтримувані значення: mongo | google_sheets
# ==============================
DB_DRIVER=mongo

# ==============================
# MongoDB (використовується, якщо DB_DRIVER=mongo)
# Локально:   mongodb://localhost:27017/hr_scheduler
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hr_scheduler
# ==============================
MONGO_URI=mongodb://localhost:27017/hr_scheduler

# ==============================
# Google Sheets (використовується лише якщо DB_DRIVER=google_sheets)
# ==============================
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Приватний ключ сервісного акаунта. Якщо копіюєте з JSON-файлу,
# залиште символи \n як є - вони екрануються автоматично в коді.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Назви аркушів (можна змінити, якщо в таблиці інші назви)
SHEET_USERS=Users
SHEET_SHIFTS=Shifts
SHEET_SCHEDULE=Schedule
SHEET_MASTER_PLAN=Master_plan

# ==============================
# Logging
# ==============================
LOG_LEVEL=info

# ==============================
# CORS
# ==============================
CORS_ORIGIN=*
