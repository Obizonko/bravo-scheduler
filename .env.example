# Змінні для docker-compose.yml (усі опційні - є безпечні дефолти).
# Скопіюйте у .env поруч із docker-compose.yml і за потреби відредагуйте.

# Порт на хості, який проксується на backend (усередині контейнера завжди 3000)
PORT=3000

CORS_ORIGIN=*
LOG_LEVEL=info

# 'off' | 'warn' | 'block' - див. README.md, розділ "Рушій правил планування"
RULES_ENFORCEMENT=block

# Нічне чергування: user_id з колекції users + локація ключів
NIGHT_EMERGENCY_USER_ID=
NIGHT_KEY_LOCATION=

# Ієрархічна авторизація (заголовок X-Admin-Pin). Порожньо на обох = гейт вимкнений,
# усі мутуючі дії відкриті. SUPER_ADMIN_PIN автоматично проходить і ADMIN_PIN-гейти.
ADMIN_PIN=
SUPER_ADMIN_PIN=

# Webhook для сповіщень про заміну. Порожньо = сповіщення лише логуються.
NOTIFICATIONS_WEBHOOK_URL=
