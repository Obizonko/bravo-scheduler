{
  "name": "hr-scheduler-backend",
  "version": "1.0.0",
  "description": "Backend API для системи планування змін та графіків співробітників (MongoDB, з рушієм правил планування чергувань)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src test scripts --ext .js",
    "lint:fix": "eslint src test scripts --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\"",
    "audit:time-formats": "node scripts/auditTimeFormats.js",
    "test": "node --test --test-reporter=spec",
    "test:watch": "node --test --watch"
  },
  "keywords": [
    "express",
    "rest-api",
    "mongodb",
    "clean-architecture",
    "scheduler",
    "rules-engine"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "dotenv": "^16.4.5",
    "mongoose": "^8.5.1",
    "joi": "^17.13.3",
    "winston": "^3.13.1",
    "morgan": "^1.10.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "express-async-errors": "^3.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
