# ==============================
# Server
# ==============================
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# ==============================
# Database driver
# ==============================
DB_DRIVER=mongo

# ==============================
# MongoDB
# Локально:   mongodb://localhost:27017/hr_scheduler
# MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hr_scheduler
# ==============================
MONGO_URI=mongodb://localhost:27017/hr_scheduler

# ==============================
# Logging
# ==============================
LOG_LEVEL=info

# ==============================
# CORS
# ==============================
CORS_ORIGIN=*

# ==============================
# Rules engine
# 'off' - нічого не блокує; 'warn' - порушення в відповіді/логах, не блокує (безпечний дефолт);
# 'block' - жорсткі порушення відхиляють запис 409-кою
# ==============================
RULES_ENFORCEMENT=warn

# ==============================
# Нічне чергування (23:00-06:00): екстрений контакт і локація ключів
# emergencyUserId - user_id з колекції users, необовʼязково
# ==============================
NIGHT_EMERGENCY_USER_ID=
NIGHT_KEY_LOCATION=

# ==============================
# Легка ієрархічна авторизація (PIN у заголовку X-Admin-Pin).
# ADMIN_PIN - голова команди (призначає людей на зміни, редагує зміни/Master Plan/користувачів).
# SUPER_ADMIN_PIN - власник системи (усе те саме + призначає/знімає адмінів). Хто знає
# SUPER_ADMIN_PIN, автоматично проходить і admin-гейти - окремо вводити ADMIN_PIN не треба.
# ==============================
ADMIN_PIN=
SUPER_ADMIN_PIN=

# ==============================
# Сповіщення про заміну (triggerSubstitution). Порожньо = сповіщення лише логуються,
# нікуди не надсилаються - явний opt-in через webhook URL
# ==============================
NOTIFICATIONS_WEBHOOK_URL=
