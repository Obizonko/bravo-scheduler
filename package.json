{
  "name": "hr-scheduler-backend",
  "version": "1.0.0",
  "description": "Backend API для системи планування змін та графіків співробітників (Google Sheets як БД, з можливістю переходу на PostgreSQL/MongoDB)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "lint": "eslint src --ext .js",
    "lint:fix": "eslint src --ext .js --fix",
    "format": "prettier --write \"src/**/*.js\"",
    "test": "echo \"No tests specified yet\" && exit 0"
  },
  "keywords": [
    "express",
    "rest-api",
    "google-sheets",
    "clean-architecture",
    "scheduler"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "dotenv": "^16.4.5",
    "google-auth-library": "^9.11.0",
    "googleapis": "^140.0.1",
    "joi": "^17.13.3",
    "winston": "^3.13.1",
    "morgan": "^1.10.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "uuid": "^9.0.1",
    "express-async-errors": "^3.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "prettier": "^3.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
